PORT=3000
NODE_ENV=development
LOG_LEVEL=info
ENVIRONMENT=local

SERVICE_API_KEY= # Inbound API key (send as x-api-key header)
EMAIL_FROM= # Sender address (e.g. alerts@yourdomain.com)
EMAIL_PROVIDER=resend
CRASH_ALERT_EMAIL= # Comma-separated crash alert recipients
RESEND_API_KEY= # Resend API key
# Supabase
SUPABASE_URL= # Supabase URL
SUPABASE_PUBLISHABLE_DEFAULT_KEY= # Supabase publishable default key
SUPABASE_PUBLISHABLE_KEY= # Supabase publishable key
SUPABASE_SECRET_KEY= # Supabase secret key
SUPABASE_STORAGE_URL= # Supabase storage URL

# Cron scheduler
CRON_SCHEDULER_ENABLED=false
CRON_SCHEDULER_RELOAD_INTERVAL_MS=60000

# Odoo
ODOO_URL= # Odoo URL
ODOO_DB= # Odoo database
ODOO_USER= # Odoo user
ODOO_PASSWORD= # Odoo password


# WhatsApp (Twilio)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID= # Twilio account SID (AC...)
TWILIO_AUTH_TOKEN= # Twilio auth token
TWILIO_WHATSAPP_FROM= # WhatsApp sender: E.164 (+18156624059) or whatsapp:+18156624059 (required if no messaging service SID)
TWILIO_MESSAGING_SERVICE_SID= # Messaging Service SID (MG...); preferred over TWILIO_WHATSAPP_FROM when set

# WhatsApp inbound webhook (Twilio replies)
TWILIO_VALIDATE_SIGNATURE=true # Validate X-Twilio-Signature on inbound webhooks; set false for local testing
TWILIO_WEBHOOK_BASE_URL= # Public base URL Twilio calls (e.g. https://api.example.com); used to verify the signature behind a proxy
WHATSAPP_REVISAR_KEYWORD=REVISAR # Keyword that triggers the contract lookup reply